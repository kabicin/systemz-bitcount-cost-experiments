; ctpop on <8 x i16>, generated by new_toy.py

; The intrinsic on its own.
define <8 x i16> @intrinsic(<8 x i16> %x) {
  %r = call <8 x i16> @llvm.ctpop.v8i16(<8 x i16> %x)
  ret <8 x i16> %r
}

; Alternative: one scalar ctpop per lane.
define <8 x i16> @split(<8 x i16> %x) {
  %e0 = extractelement <8 x i16> %x, i32 0
  %c0 = call i16 @llvm.ctpop.i16(i16 %e0)
  %v0 = insertelement <8 x i16> poison, i16 %c0, i32 0
  %e1 = extractelement <8 x i16> %x, i32 1
  %c1 = call i16 @llvm.ctpop.i16(i16 %e1)
  %v1 = insertelement <8 x i16> %v0, i16 %c1, i32 1
  %e2 = extractelement <8 x i16> %x, i32 2
  %c2 = call i16 @llvm.ctpop.i16(i16 %e2)
  %v2 = insertelement <8 x i16> %v1, i16 %c2, i32 2
  %e3 = extractelement <8 x i16> %x, i32 3
  %c3 = call i16 @llvm.ctpop.i16(i16 %e3)
  %v3 = insertelement <8 x i16> %v2, i16 %c3, i32 3
  %e4 = extractelement <8 x i16> %x, i32 4
  %c4 = call i16 @llvm.ctpop.i16(i16 %e4)
  %v4 = insertelement <8 x i16> %v3, i16 %c4, i32 4
  %e5 = extractelement <8 x i16> %x, i32 5
  %c5 = call i16 @llvm.ctpop.i16(i16 %e5)
  %v5 = insertelement <8 x i16> %v4, i16 %c5, i32 5
  %e6 = extractelement <8 x i16> %x, i32 6
  %c6 = call i16 @llvm.ctpop.i16(i16 %e6)
  %v6 = insertelement <8 x i16> %v5, i16 %c6, i32 6
  %e7 = extractelement <8 x i16> %x, i32 7
  %c7 = call i16 @llvm.ctpop.i16(i16 %e7)
  %v7 = insertelement <8 x i16> %v6, i16 %c7, i32 7
  ret <8 x i16> %v7
}

; d[i] = ctpop(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds <8 x i16>, ptr %s, i64 %i
  %x = load <8 x i16>, ptr %ps, align 16
  %c = call <8 x i16> @llvm.ctpop.v8i16(<8 x i16> %x)
  %pd = getelementptr inbounds <8 x i16>, ptr %d, i64 %i
  store <8 x i16> %c, ptr %pd, align 16
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
