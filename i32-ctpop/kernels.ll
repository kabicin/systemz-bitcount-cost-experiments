; ctpop on i32, generated by new_toy.py

; The intrinsic on its own.
define i32 @intrinsic(i32 %x) {
  %r = call i32 @llvm.ctpop.i32(i32 %x)
  ret i32 %r
}

; Alternative: two half-width operations: ctpop(lo) + ctpop(hi).
define i32 @split(i32 %x) {
  %lo = trunc i32 %x to i16
  %sh = lshr i32 %x, 16
  %hi = trunc i32 %sh to i16
  %a = call i16 @llvm.ctpop.i16(i16 %lo)
  %b = call i16 @llvm.ctpop.i16(i16 %hi)
  %r.h = add i16 %a, %b
  %r = zext i16 %r.h to i32
  ret i32 %r
}

; d[0..1] = ctpop(a[0..1]): 2 values from memory, for the SLP vectorizer.
define void @slp2(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i32, ptr %a, i64 0
  %x0 = load i32, ptr %pa0, align 4
  %pa1 = getelementptr inbounds i32, ptr %a, i64 1
  %x1 = load i32, ptr %pa1, align 4
  %c0 = call i32 @llvm.ctpop.i32(i32 %x0)
  %c1 = call i32 @llvm.ctpop.i32(i32 %x1)
  %pd0 = getelementptr inbounds i32, ptr %d, i64 0
  store i32 %c0, ptr %pd0, align 4
  %pd1 = getelementptr inbounds i32, ptr %d, i64 1
  store i32 %c1, ptr %pd1, align 4
  ret void
}

; d[0..3] = ctpop(a[0..3]): 4 values from memory, for the SLP vectorizer.
define void @slp4(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i32, ptr %a, i64 0
  %x0 = load i32, ptr %pa0, align 4
  %pa1 = getelementptr inbounds i32, ptr %a, i64 1
  %x1 = load i32, ptr %pa1, align 4
  %pa2 = getelementptr inbounds i32, ptr %a, i64 2
  %x2 = load i32, ptr %pa2, align 4
  %pa3 = getelementptr inbounds i32, ptr %a, i64 3
  %x3 = load i32, ptr %pa3, align 4
  %c0 = call i32 @llvm.ctpop.i32(i32 %x0)
  %c1 = call i32 @llvm.ctpop.i32(i32 %x1)
  %c2 = call i32 @llvm.ctpop.i32(i32 %x2)
  %c3 = call i32 @llvm.ctpop.i32(i32 %x3)
  %pd0 = getelementptr inbounds i32, ptr %d, i64 0
  store i32 %c0, ptr %pd0, align 4
  %pd1 = getelementptr inbounds i32, ptr %d, i64 1
  store i32 %c1, ptr %pd1, align 4
  %pd2 = getelementptr inbounds i32, ptr %d, i64 2
  store i32 %c2, ptr %pd2, align 4
  %pd3 = getelementptr inbounds i32, ptr %d, i64 3
  store i32 %c3, ptr %pd3, align 4
  ret void
}

; d[0..7] = ctpop(a[0..7]): 8 values from memory, for the SLP vectorizer.
define void @slp8(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i32, ptr %a, i64 0
  %x0 = load i32, ptr %pa0, align 4
  %pa1 = getelementptr inbounds i32, ptr %a, i64 1
  %x1 = load i32, ptr %pa1, align 4
  %pa2 = getelementptr inbounds i32, ptr %a, i64 2
  %x2 = load i32, ptr %pa2, align 4
  %pa3 = getelementptr inbounds i32, ptr %a, i64 3
  %x3 = load i32, ptr %pa3, align 4
  %pa4 = getelementptr inbounds i32, ptr %a, i64 4
  %x4 = load i32, ptr %pa4, align 4
  %pa5 = getelementptr inbounds i32, ptr %a, i64 5
  %x5 = load i32, ptr %pa5, align 4
  %pa6 = getelementptr inbounds i32, ptr %a, i64 6
  %x6 = load i32, ptr %pa6, align 4
  %pa7 = getelementptr inbounds i32, ptr %a, i64 7
  %x7 = load i32, ptr %pa7, align 4
  %c0 = call i32 @llvm.ctpop.i32(i32 %x0)
  %c1 = call i32 @llvm.ctpop.i32(i32 %x1)
  %c2 = call i32 @llvm.ctpop.i32(i32 %x2)
  %c3 = call i32 @llvm.ctpop.i32(i32 %x3)
  %c4 = call i32 @llvm.ctpop.i32(i32 %x4)
  %c5 = call i32 @llvm.ctpop.i32(i32 %x5)
  %c6 = call i32 @llvm.ctpop.i32(i32 %x6)
  %c7 = call i32 @llvm.ctpop.i32(i32 %x7)
  %pd0 = getelementptr inbounds i32, ptr %d, i64 0
  store i32 %c0, ptr %pd0, align 4
  %pd1 = getelementptr inbounds i32, ptr %d, i64 1
  store i32 %c1, ptr %pd1, align 4
  %pd2 = getelementptr inbounds i32, ptr %d, i64 2
  store i32 %c2, ptr %pd2, align 4
  %pd3 = getelementptr inbounds i32, ptr %d, i64 3
  store i32 %c3, ptr %pd3, align 4
  %pd4 = getelementptr inbounds i32, ptr %d, i64 4
  store i32 %c4, ptr %pd4, align 4
  %pd5 = getelementptr inbounds i32, ptr %d, i64 5
  store i32 %c5, ptr %pd5, align 4
  %pd6 = getelementptr inbounds i32, ptr %d, i64 6
  store i32 %c6, ptr %pd6, align 4
  %pd7 = getelementptr inbounds i32, ptr %d, i64 7
  store i32 %c7, ptr %pd7, align 4
  ret void
}

; d[i] = zext(ctpop(s[i])) + e[i], with s of i32 and d, e of i64: the loop
; vectorizer must choose a vectorization factor for two element widths.
define void @mix(ptr noalias %d, ptr noalias %s, ptr noalias %e, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i32, ptr %s, i64 %i
  %x = load i32, ptr %ps, align 4
  %c = call i32 @llvm.ctpop.i32(i32 %x)
  %cx = zext i32 %c to i64
  %pe = getelementptr inbounds i64, ptr %e, i64 %i
  %y = load i64, ptr %pe, align 8
  %r = add i64 %cx, %y
  %pd = getelementptr inbounds i64, ptr %d, i64 %i
  store i64 %r, ptr %pd, align 8
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

; d[i] = ctpop(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i32, ptr %s, i64 %i
  %x = load i32, ptr %ps, align 4
  %c = call i32 @llvm.ctpop.i32(i32 %x)
  %pd = getelementptr inbounds i32, ptr %d, i64 %i
  store i32 %c, ptr %pd, align 4
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
