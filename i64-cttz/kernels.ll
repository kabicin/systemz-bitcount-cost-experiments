; cttz on i64, generated by new_toy.py

; The intrinsic on its own.
define i64 @intrinsic(i64 %x) {
  %r = call i64 @llvm.cttz.i64(i64 %x, i1 false)
  ret i64 %r
}

; Alternative: two half-width operations: lo != 0 ? cttz(lo) : 32 + cttz(hi).
define i64 @split(i64 %x) {
  %lo = trunc i64 %x to i32
  %sh = lshr i64 %x, 32
  %hi = trunc i64 %sh to i32
  %t1 = call i32 @llvm.cttz.i32(i32 %lo, i1 true)
  %t2 = call i32 @llvm.cttz.i32(i32 %hi, i1 false)
  %t2.h = add i32 %t2, 32
  %nz = icmp ne i32 %lo, 0
  %r.h = select i1 %nz, i32 %t1, i32 %t2.h
  %r = zext i32 %r.h to i64
  ret i64 %r
}

; d[0..1] = cttz(a[0..1]): 2 values from memory, for the SLP vectorizer.
define void @slp2(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i64, ptr %a, i64 0
  %x0 = load i64, ptr %pa0, align 8
  %pa1 = getelementptr inbounds i64, ptr %a, i64 1
  %x1 = load i64, ptr %pa1, align 8
  %c0 = call i64 @llvm.cttz.i64(i64 %x0, i1 false)
  %c1 = call i64 @llvm.cttz.i64(i64 %x1, i1 false)
  %pd0 = getelementptr inbounds i64, ptr %d, i64 0
  store i64 %c0, ptr %pd0, align 8
  %pd1 = getelementptr inbounds i64, ptr %d, i64 1
  store i64 %c1, ptr %pd1, align 8
  ret void
}

; d[0..3] = cttz(a[0..3]): 4 values from memory, for the SLP vectorizer.
define void @slp4(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i64, ptr %a, i64 0
  %x0 = load i64, ptr %pa0, align 8
  %pa1 = getelementptr inbounds i64, ptr %a, i64 1
  %x1 = load i64, ptr %pa1, align 8
  %pa2 = getelementptr inbounds i64, ptr %a, i64 2
  %x2 = load i64, ptr %pa2, align 8
  %pa3 = getelementptr inbounds i64, ptr %a, i64 3
  %x3 = load i64, ptr %pa3, align 8
  %c0 = call i64 @llvm.cttz.i64(i64 %x0, i1 false)
  %c1 = call i64 @llvm.cttz.i64(i64 %x1, i1 false)
  %c2 = call i64 @llvm.cttz.i64(i64 %x2, i1 false)
  %c3 = call i64 @llvm.cttz.i64(i64 %x3, i1 false)
  %pd0 = getelementptr inbounds i64, ptr %d, i64 0
  store i64 %c0, ptr %pd0, align 8
  %pd1 = getelementptr inbounds i64, ptr %d, i64 1
  store i64 %c1, ptr %pd1, align 8
  %pd2 = getelementptr inbounds i64, ptr %d, i64 2
  store i64 %c2, ptr %pd2, align 8
  %pd3 = getelementptr inbounds i64, ptr %d, i64 3
  store i64 %c3, ptr %pd3, align 8
  ret void
}

; d[i] = trunc(cttz(s[i])) + e[i], with s of i64 and d, e of i32: the loop
; vectorizer must choose a vectorization factor for two element widths.
define void @mix(ptr noalias %d, ptr noalias %s, ptr noalias %e, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i64, ptr %s, i64 %i
  %x = load i64, ptr %ps, align 8
  %c = call i64 @llvm.cttz.i64(i64 %x, i1 false)
  %cx = trunc i64 %c to i32
  %pe = getelementptr inbounds i32, ptr %e, i64 %i
  %y = load i32, ptr %pe, align 4
  %r = add i32 %cx, %y
  %pd = getelementptr inbounds i32, ptr %d, i64 %i
  store i32 %r, ptr %pd, align 4
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

; d[i] = cttz(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i64, ptr %s, i64 %i
  %x = load i64, ptr %ps, align 8
  %c = call i64 @llvm.cttz.i64(i64 %x, i1 false)
  %pd = getelementptr inbounds i64, ptr %d, i64 %i
  store i64 %c, ptr %pd, align 8
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
