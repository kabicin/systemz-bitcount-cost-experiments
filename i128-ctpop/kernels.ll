; ctpop on i128, generated by new_toy.py

; The intrinsic on its own.
define i128 @intrinsic(i128 %x) {
  %r = call i128 @llvm.ctpop.i128(i128 %x)
  ret i128 %r
}

; Alternative: two half-width operations: ctpop(lo) + ctpop(hi).
define i128 @split(i128 %x) {
  %lo = trunc i128 %x to i64
  %sh = lshr i128 %x, 64
  %hi = trunc i128 %sh to i64
  %a = call i64 @llvm.ctpop.i64(i64 %lo)
  %b = call i64 @llvm.ctpop.i64(i64 %hi)
  %r.h = add i64 %a, %b
  %r = zext i64 %r.h to i128
  ret i128 %r
}

; d[0..1] = ctpop(a[0..1]): 2 values from memory, for the SLP vectorizer.
define void @slp2(ptr noalias %d, ptr noalias %a) {
  %pa0 = getelementptr inbounds i128, ptr %a, i64 0
  %x0 = load i128, ptr %pa0, align 16
  %pa1 = getelementptr inbounds i128, ptr %a, i64 1
  %x1 = load i128, ptr %pa1, align 16
  %c0 = call i128 @llvm.ctpop.i128(i128 %x0)
  %c1 = call i128 @llvm.ctpop.i128(i128 %x1)
  %pd0 = getelementptr inbounds i128, ptr %d, i64 0
  store i128 %c0, ptr %pd0, align 16
  %pd1 = getelementptr inbounds i128, ptr %d, i64 1
  store i128 %c1, ptr %pd1, align 16
  ret void
}

; d[i] = ctpop(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i128, ptr %s, i64 %i
  %x = load i128, ptr %ps, align 16
  %c = call i128 @llvm.ctpop.i128(i128 %x)
  %pd = getelementptr inbounds i128, ptr %d, i64 %i
  store i128 %c, ptr %pd, align 16
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
