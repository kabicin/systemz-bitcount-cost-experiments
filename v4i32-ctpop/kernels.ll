; ctpop on <4 x i32>, generated by new_toy.py

; The intrinsic on its own.
define <4 x i32> @intrinsic(<4 x i32> %x) {
  %r = call <4 x i32> @llvm.ctpop.v4i32(<4 x i32> %x)
  ret <4 x i32> %r
}

; Alternative: one scalar ctpop per lane.
define <4 x i32> @split(<4 x i32> %x) {
  %e0 = extractelement <4 x i32> %x, i32 0
  %c0 = call i32 @llvm.ctpop.i32(i32 %e0)
  %v0 = insertelement <4 x i32> poison, i32 %c0, i32 0
  %e1 = extractelement <4 x i32> %x, i32 1
  %c1 = call i32 @llvm.ctpop.i32(i32 %e1)
  %v1 = insertelement <4 x i32> %v0, i32 %c1, i32 1
  %e2 = extractelement <4 x i32> %x, i32 2
  %c2 = call i32 @llvm.ctpop.i32(i32 %e2)
  %v2 = insertelement <4 x i32> %v1, i32 %c2, i32 2
  %e3 = extractelement <4 x i32> %x, i32 3
  %c3 = call i32 @llvm.ctpop.i32(i32 %e3)
  %v3 = insertelement <4 x i32> %v2, i32 %c3, i32 3
  ret <4 x i32> %v3
}

; d[i] = ctpop(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds <4 x i32>, ptr %s, i64 %i
  %x = load <4 x i32>, ptr %ps, align 16
  %c = call <4 x i32> @llvm.ctpop.v4i32(<4 x i32> %x)
  %pd = getelementptr inbounds <4 x i32>, ptr %d, i64 %i
  store <4 x i32> %c, ptr %pd, align 16
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
