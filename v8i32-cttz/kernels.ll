; cttz on <8 x i32>, generated by new_toy.py

; The intrinsic on its own.
define <8 x i32> @intrinsic(<8 x i32> %x) {
  %r = call <8 x i32> @llvm.cttz.v8i32(<8 x i32> %x, i1 false)
  ret <8 x i32> %r
}

; Alternative: one scalar cttz per lane.
define <8 x i32> @split(<8 x i32> %x) {
  %e0 = extractelement <8 x i32> %x, i32 0
  %c0 = call i32 @llvm.cttz.i32(i32 %e0, i1 false)
  %v0 = insertelement <8 x i32> poison, i32 %c0, i32 0
  %e1 = extractelement <8 x i32> %x, i32 1
  %c1 = call i32 @llvm.cttz.i32(i32 %e1, i1 false)
  %v1 = insertelement <8 x i32> %v0, i32 %c1, i32 1
  %e2 = extractelement <8 x i32> %x, i32 2
  %c2 = call i32 @llvm.cttz.i32(i32 %e2, i1 false)
  %v2 = insertelement <8 x i32> %v1, i32 %c2, i32 2
  %e3 = extractelement <8 x i32> %x, i32 3
  %c3 = call i32 @llvm.cttz.i32(i32 %e3, i1 false)
  %v3 = insertelement <8 x i32> %v2, i32 %c3, i32 3
  %e4 = extractelement <8 x i32> %x, i32 4
  %c4 = call i32 @llvm.cttz.i32(i32 %e4, i1 false)
  %v4 = insertelement <8 x i32> %v3, i32 %c4, i32 4
  %e5 = extractelement <8 x i32> %x, i32 5
  %c5 = call i32 @llvm.cttz.i32(i32 %e5, i1 false)
  %v5 = insertelement <8 x i32> %v4, i32 %c5, i32 5
  %e6 = extractelement <8 x i32> %x, i32 6
  %c6 = call i32 @llvm.cttz.i32(i32 %e6, i1 false)
  %v6 = insertelement <8 x i32> %v5, i32 %c6, i32 6
  %e7 = extractelement <8 x i32> %x, i32 7
  %c7 = call i32 @llvm.cttz.i32(i32 %e7, i1 false)
  %v7 = insertelement <8 x i32> %v6, i32 %c7, i32 7
  ret <8 x i32> %v7
}

; d[i] = cttz(s[i])
define void @loop(ptr noalias %d, ptr noalias %s, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds <8 x i32>, ptr %s, i64 %i
  %x = load <8 x i32>, ptr %ps, align 16
  %c = call <8 x i32> @llvm.cttz.v8i32(<8 x i32> %x, i1 false)
  %pd = getelementptr inbounds <8 x i32>, ptr %d, i64 %i
  store <8 x i32> %c, ptr %pd, align 16
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
